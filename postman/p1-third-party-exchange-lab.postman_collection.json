              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Vendor comparison table\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().columns.length).to.be.above(0);",
