                  "pm.test(\"Exchange a PingFederate client-credentials JWT\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().ok).to.eql(true);",
                  "  pm.expect(pm.response.json().checks).to.be.an('array');",
                  "});"
