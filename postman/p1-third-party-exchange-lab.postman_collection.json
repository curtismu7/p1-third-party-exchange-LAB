{
  "info": {
    "name": "P1 Third-Party Exchange LAB",
    "description": "API collection for P1 Third-Party Exchange LAB: PingOne token exchange with third-party-signed JWTs. Run the exchange with each vendor's token profile (PingFederate, PingOne, Okta, Auth0, RFC 9068...), read the vendor comparison table and the wire/setup guides. Everything runs in-process against a labelled mock; the lab has no live mode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-p1-third-party-exchange-lab"
  },
  "item": [
    {
      "name": "Sanity (mock, labelled)",
      "description": "Health, mode info (always mock), the vendor catalog with its evidence, and the comparison table.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().state).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Info (mode is mock by design)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Info (mode is mock by design)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().mode).to.eql('mock');",
                  "  pm.expect(pm.response.json().simulated).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
