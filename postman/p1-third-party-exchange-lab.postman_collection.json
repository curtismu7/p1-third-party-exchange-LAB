    {
      "name": "Exchange runs",
      "description": "One token exchange per request, with the vendor's token profile minted in-process. vendorId comes from /api/vendors (pf-cc, pf-oidc, p1, okta, auth0, rfc9068...).",
      "item": [
        {
          "name": "Exchange an unknown vendor (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Exchange an unknown vendor (negative)\", function () {",
                  "  pm.expect(pm.response.code).to.eql(400);",
                  "  pm.expect(pm.response.json().error).to.eql('unknown_vendor');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": \"nope\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/exchange",
              "host": [
